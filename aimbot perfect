                                        elseif d.boxSq then d.boxSq.Visible = false end
                                        
                                        if espOn then
                                            local hum2 = pc._hum or char:FindFirstChildOfClass("Humanoid")
                                            local pct = hum2 and hum2.MaxHealth > 0 and math.clamp(hum2.Health / hum2.MaxHealth, 0, 1) or 1
                                            local barX, barW, barH = bx - 6, 3, bh
                                            local fillH = barH * pct
                                            if d.hpBg then d.hpBg.Visible = true; d.hpBg.Position = Vector2.new(barX, by); d.hpBg.Size = Vector2.new(barW, barH) end
                                            if d.hpFg then d.hpFg.Visible = true; d.hpFg.Color = _hpColor(pct); d.hpFg.Position = Vector2.new(barX, by + barH - fillH); d.hpFg.Size = Vector2.new(barW, fillH) end
                                        else
                                            if d.hpBg then d.hpBg.Visible = false end
                                            if d.hpFg then d.hpFg.Visible = false end
                                        end
                                    else
