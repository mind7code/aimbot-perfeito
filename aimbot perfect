local function addToggle(parent, order, title, key, onChange)
    local row = Instance.new("Frame", parent)
    row.Size = UD2new(1, -12, 0, 36); row.BackgroundColor3 = T.Row; row.BorderSizePixel = 0; row.LayoutOrder = order
