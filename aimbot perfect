local function addColorPicker(parent, order, title, cfgKey, onChange)
    local row = Instance.new("Frame", parent)
    row.Size = UD2new(1, -4, 0, 56); row.BackgroundColor3 = T.Row; row.BorderSizePixel = 0; row.LayoutOrder = order
    mkCorner(row, 8)
    local rs = Instance.new("UIStroke", row); rs.Color = T.Border; rs.Thickness = 1

    local lbl = Instance.new("TextLabel", row)
    lbl.Size = UD2new(1, -16, 0, 20); lbl.Position = UD2new(0, 12, 0, 4); lbl.BackgroundTransparency = 1
    lbl.Text = title; lbl.TextColor3 = T.Text; lbl.TextSize = 12; lbl.Font = Enum.Font.GothamBold; lbl.TextXAlignment = Enum.TextXAlignment.Left

    local swRow = Instance.new("Frame", row)
    swRow.Size = UD2new(1, -20, 0, 24); swRow.Position = UD2new(0, 10, 0, 26); swRow.BackgroundTransparency = 1
    local swLayout = Instance.new("UIListLayout", swRow)
    swLayout.FillDirection = Enum.FillDirection.Horizontal; swLayout.Padding = UDnew(0, 6); swLayout.SortOrder = Enum.SortOrder.LayoutOrder

    local swatches = {}
    for i, col in ipairs(COLOR_PRESETS) do
        local sw = Instance.new("TextButton", swRow)
        sw.Size = UD2new(0, 24, 0, 24); sw.BackgroundColor3 = col; sw.Text = ""; sw.BorderSizePixel = 0; sw.AutoButtonColor = false
        sw.LayoutOrder = i; mkCorner(sw, 6)
        local ring = Instance.new("UIStroke", sw)
        ring.Color = T.White; ring.Thickness = (CFG[cfgKey] == col) and 2 or 0
        swatches[i] = { btn = sw, ring = ring, color = col }
        sw.MouseButton1Click:Connect(function()
            CFG[cfgKey] = col
            for _, s in ipairs(swatches) do s.ring.Thickness = (s.color == col) and 2 or 0 end
            if onChange then onChange(col) end
        end)
    end
end

