    end
    
    -- Lista de players para remover (mortos/sem personagem)
    local toRemove = {}
    
    for pl, d in pairs(_espData) do
        local char = pl.Character
        
        -- ✅ CORRIGIDO: Verifica se o player ainda existe e tem personagem valido
        if not pl.Parent or not char or not char.Parent then
