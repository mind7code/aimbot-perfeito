-- FLY ANTI-DETECT (BodyVelocity & Heartbeat)
local _flyConn, _flyCharConn = nil, nil
local _flyPrevWalk, _flyPrevJump = 16, 50

local function flyStart()
    if _flyConn then return end
    local char = LP.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildWhichIsA("Humanoid")
    if not hrp or not hum then return end

    _flyPrevWalk = hum.WalkSpeed
    _flyPrevJump = hum.JumpPower
    hum.WalkSpeed = 16
    hum.JumpPower = 50

    CFG.FlyOn = true

    local bodyVel = Instance.new("BodyVelocity")
    bodyVel.Name = "M7_FlyBV"
    bodyVel.MaxForce = Vector3.new(40000, 40000, 40000)
    bodyVel.P = 1250
    bodyVel.Velocity = Vector3.zero
    bodyVel.Parent = hrp

    _flyConn = Run.Heartbeat:Connect(function()
        local c = LP.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if not r or not bodyVel or not bodyVel.Parent then return end

        local speed = CFG.FlySpeed
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then speed = speed * 2.5 end

        local cf    = Cam.CFrame
        local fwd   = V3new(cf.LookVector.X, 0, cf.LookVector.Z)
        local right = V3new(cf.RightVector.X, 0, cf.RightVector.Z)
        fwd   = fwd.Magnitude   > 0.01 and fwd.Unit   or V3zero
        right = right.Magnitude > 0.01 and right.Unit or V3zero

        local dir = V3zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + fwd end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - fwd end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - right end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + right end
        if UIS:IsKeyDown(Enum.KeyCode.Space)       then dir = dir + V3new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - V3new(0, 1, 0) end

        if dir.Magnitude > 0.01 then
            bodyVel.Velocity = dir.Unit * speed
        else
            bodyVel.Velocity = Vector3.zero
        end
    end)

    if _flyCharConn then _flyCharConn:Disconnect() end
    _flyCharConn = LP.CharacterAdded:Connect(function()
        if bodyVel and bodyVel.Parent then bodyVel:Destroy() end
        if _flyConn then _flyConn:Disconnect(); _flyConn = nil end
        CFG.FlyOn = false
    end)
end

local function flyStop()
    CFG.FlyOn = false
    if _flyConn     then _flyConn:Disconnect();     _flyConn = nil end
    if _flyCharConn then _flyCharConn:Disconnect(); _flyCharConn = nil end

    local char = LP.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local bv = hrp:FindFirstChild("M7_FlyBV") or hrp:FindFirstChildOfClass("BodyVelocity")
        if bv then bv:Destroy() end
        hrp.AssemblyLinearVelocity = V3zero
    end

    local hum = char and char:FindFirstChildWhichIsA("Humanoid")
    if hum then hum.WalkSpeed = _flyPrevWalk; hum.JumpPower = _flyPrevJump end
    arStop()
end

-- CAR BOOST
local carBoostConn = nil
local function _getOccupiedSeat()
    local char = LP.Character
    if not char then return nil end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if not hum then return nil end
    local seat = hum.SeatPart
    if seat and seat:IsA("VehicleSeat") then return seat end
    return nil
end

local function carBoostStart()
    if carBoostConn then return end
    CFG.CarBoostOn = true
    carBoostConn = Run.Heartbeat:Connect(function()
        local seat = _getOccupiedSeat()
        if not seat then return end
        local vehModel = seat:FindFirstAncestorWhichIsA("Model")
        if not vehModel then return end
        local root = vehModel.PrimaryPart or seat
        if not root then return end
        local speed = CFG.CarSpeed
        local fwd = V3new(seat.CFrame.LookVector.X, 0, seat.CFrame.LookVector.Z)
        if fwd.Magnitude < 0.01 then return end
        fwd = fwd.Unit
        local curY = root.AssemblyLinearVelocity.Y
        pcall(function() root.AssemblyLinearVelocity = V3new(fwd.X * speed, curY, fwd.Z * speed) end)
    end)
end

local function carBoostStop()
    CFG.CarBoostOn = false
    if carBoostConn then carBoostConn:Disconnect(); carBoostConn = nil end
end

