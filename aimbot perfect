    "RightUpperLeg", "RightLowerLeg", "RightFoot",
    "Left Arm", "Right Arm", "Left Leg", "Right Leg",
}

local function _projectAll(pc)
    local anyVis = false
    for _, name in ipairs(PROJ_NAMES) do
        local part = pc[name]
        if part and part.Parent then
            local sp, vis = Cam:WorldToViewportPoint(part.Position)
            if vis and sp.Z > 0 then
                _proj2D[name] = V2new(sp.X, sp.Y)
                anyVis = true
            else
                _proj2D[name] = false
            end
        else
            _proj2D[name] = false
        end
    end
    return anyVis and _proj2D.Head
end

local function _p(name1, name2)
    local v = _proj2D[name1]
    if v then return v end
    if name2 then return _proj2D[name2] or nil end
    return nil
end

local function _drawSkeletonFast(lines, col, thick)
    local idx = 1
    local function l(p1, p2)
        local ln = lines[idx]; idx = idx + 1
        if not ln then return end
        if p1 and p2 then
            ln.From = p1; ln.To = p2; ln.Color = col; ln.Thickness = thick; ln.Visible = true
        else
            ln.Visible = false
        end
    end

    local head = _p("Head")
    local ut   = _p("UpperTorso", "Torso")
    local lt   = _p("LowerTorso", "HumanoidRootPart")
    l(head, ut); l(ut, lt)

    local lua = _p("LeftUpperArm", "Left Arm")
    local lla = _p("LeftLowerArm")
    local lh  = _p("LeftHand")
    l(ut, lua); l(lua, lla or lh); l(lla and lh or nil, lla and lh or nil)

    local rua = _p("RightUpperArm", "Right Arm")
    local rla = _p("RightLowerArm")
    local rh  = _p("RightHand")
    l(ut, rua); l(rua, rla or rh); l(rla and rh or nil, rla and rh or nil)

    local lul = _p("LeftUpperLeg", "Left Leg")
    local lll = _p("LeftLowerLeg")
    local lf  = _p("LeftFoot")
    l(lt, lul); l(lul, lll or lf); l(lll and lf or nil, lll and lf or nil)

    local rul = _p("RightUpperLeg", "Right Leg")
    local rll = _p("RightLowerLeg")
    local rf  = _p("RightFoot")
    l(lt, rul); l(rul, rll or rf); l(rll and rf or nil, rll and rf or nil)

    for i = idx, #lines do if lines[i] then lines[i].Visible = false end end
end

-- CHAMS 3D (BoxHandleAdornment - Zero Highlight)
local _chamsAdornments = {}
local function updateChams(pl, char)
    if not CFG.ChamsOn then
        if _chamsAdornments[pl] then
            for _, b in ipairs(_chamsAdornments[pl]) do pcall(function() b:Destroy() end) end
            _chamsAdornments[pl] = nil
        end
        return
    end
    if char and char.Parent then
        local adorns = _chamsAdornments[pl]
        if not adorns then
            adorns = {}
            for _, p in ipairs(char:GetChildren()) do
                if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                    local b = Instance.new("BoxHandleAdornment")
                    b.Name = "M7_Adorn"
                    b.Size = p.Size
                    b.Color3 = CFG.ChamsColor
                    b.Transparency = 0.45
                    b.AlwaysOnTop = true
                    b.ZIndex = 5
                    b.Adornee = p
                    b.Parent = p
                    adorns[#adorns + 1] = b
                end
            end
            _chamsAdornments[pl] = adorns
        else
            for _, b in ipairs(adorns) do
                if b and b.Parent then
                    b.Color3 = CFG.ChamsColor
                end
            end
        end
    end
end

local function _drawSkelHeadFast(pc, skelHead, col, thick)
    if not skelHead then return end
    local head = pc.Head
    if head and head.Parent then
        local sp, vis = Cam:WorldToViewportPoint(head.Position)
        if vis and sp.Z > 0 then
            skelHead.Position = V2new(sp.X, sp.Y)
            skelHead.Radius = mmax(3, 1400 / sp.Z)
            skelHead.Color = col
            skelHead.Thickness = thick
            skelHead.Visible = true
            return
        end
    end
    skelHead.Visible = false
end

local function _bboxFromProjections()
    local minX, minY = mhuge, mhuge
    local maxX, maxY = -mhuge, -mhuge
    local count = 0
    for _, pos in pairs(_proj2D) do
        if pos then
            if pos.X < minX then minX = pos.X end
            if pos.Y < minY then minY = pos.Y end
            if pos.X > maxX then maxX = pos.X end
            if pos.Y > maxY then maxY = pos.Y end
            count = count + 1
        end
    end
    if count >= 2 and minX < maxX and minY < maxY then
        local pad = 4
        return minX - pad, minY - pad, (maxX - minX) + (pad * 2), (maxY - minY) + (pad * 2)
    end
    return nil, nil, nil, nil
end

local function _hpColor(pct)
    if pct > 0.6 then
        return C3rgb(50, 215, 90)
    elseif pct > 0.3 then
        return C3rgb(255, 200, 0)
    else
        return C3rgb(230, 35, 60)
    end
end

