local function switchTab(name)
    for n, pg in pairs(pages) do pg.Visible = (n == name) end
    for _, ch in ipairs(Sidebar:GetChildren()) do
        if ch:IsA("TextButton") then
            local bg = ch:FindFirstChild("__TabBG")
            if bg then
                bg.Visible = (ch.Name == name)
                local stroke = bg:FindFirstChildWhichIsA("UIStroke")
                if stroke then
                    stroke.Color = (ch.Name == name) and T.Accent or T.Border
                    stroke.Thickness = (ch.Name == name) and 1 or 0
                end
            end
            local ico = ch:FindFirstChild("__TabIco")
            if ico then ico.TextColor3 = (ch.Name == name) and T.AccentBr or T.TextDim end
            local lbl = ch:FindFirstChildWhichIsA("TextLabel")
            if lbl and lbl.Name ~= "__TabIco" then
                lbl.TextColor3 = (ch.Name == name) and T.Text or T.TextDim
            end
        end
    end
