-- CACHE DE PARTES DO PERSONAGEM
-- ═══════════════════════════════════════════════
local _partCache  = {}
local _cacheConns = {}

local CACHE_PART_NAMES = {
    "Head", "HumanoidRootPart",
    "UpperTorso", "LowerTorso", "Torso",
    "LeftUpperArm", "LeftLowerArm", "LeftHand",
    "RightUpperArm", "RightLowerArm", "RightHand",
    "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
    "RightUpperLeg", "RightLowerLeg", "RightFoot",
    "Left Arm", "Right Arm", "Left Leg", "Right Leg",
}

local function _buildPartCache(char)
    if not char or not char.Parent then return end
    local cache = {}
    for _, name in ipairs(CACHE_PART_NAMES) do
        local p = char:FindFirstChild(name)
        if p and p:IsA("BasePart") then cache[name] = p end
    end
    cache._hum = char:FindFirstChildOfClass("Humanoid")
    _partCache[char] = cache

    if _cacheConns[char] then
        for _, c in ipairs(_cacheConns[char]) do pcall(function() c:Disconnect() end) end
    end
    local conns = {}
    conns[1] = char.ChildAdded:Connect(function(child)
        if child:IsA("BasePart") then
            local cn = child.Name
            for _, name in ipairs(CACHE_PART_NAMES) do
                if cn == name then cache[cn] = child; break end
            end
        elseif child:IsA("Humanoid") then
            cache._hum = child
        end
    end)
    conns[2] = char.ChildRemoved:Connect(function(child)
        if child:IsA("BasePart") and cache[child.Name] == child then
            cache[child.Name] = nil
        elseif child:IsA("Humanoid") and cache._hum == child then
            cache._hum = nil
        end
    end)
    conns[3] = char.AncestryChanged:Connect(function(_, parent)
        if not parent then
            _partCache[char] = nil
            if _cacheConns[char] then
                for _, c2 in ipairs(_cacheConns[char]) do pcall(function() c2:Disconnect() end) end
                _cacheConns[char] = nil
            end
        end
    end)
    _cacheConns[char] = conns
end

local function _getPartCache(char)
    if not char or not char.Parent then return nil end
    local c = _partCache[char]
    if not c then
        _buildPartCache(char)
        c = _partCache[char]
    end
    return c
end

local function _clearPartCache(char)
    _partCache[char] = nil
    if _cacheConns[char] then
        for _, c in ipairs(_cacheConns[char]) do pcall(function() c:Disconnect() end) end
        _cacheConns[char] = nil
    end
end

-- ═══════════════════════════════════════════════
-- ANTI-RAGDOLL SYSTEM
-- ═══════════════════════════════════════════════
local _arRefCount    = 0
local _arSteppedConn = nil
local _arDescConn    = nil
local _arCharConn    = nil
local _arMotors      = {}

local function _arBuildMotorCache(char)
    _arMotors = {}
    if not char then return end
    for _, obj in ipairs(char:GetDescendants()) do
        if obj:IsA("Motor6D") then _arMotors[#_arMotors+1] = obj end
    end
end

local function _arApply(char)
    if not char then return end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if not hum then return end

    if _arSteppedConn then _arSteppedConn:Disconnect(); _arSteppedConn = nil end
    if _arDescConn    then _arDescConn:Disconnect();    _arDescConn    = nil end

    _arBuildMotorCache(char)

    _arDescConn = char.DescendantAdded:Connect(function(obj)
        if _arRefCount <= 0 then return end
        if obj:IsA("BallSocketConstraint") or obj:IsA("HingeConstraint") then
            pcall(function() obj:Destroy() end)
        elseif obj:IsA("Motor6D") then
            _arMotors[#_arMotors+1] = obj
            obj.Enabled = true
        end
    end)

    _arSteppedConn = Run.Stepped:Connect(function()
        if _arRefCount <= 0 then return end
        for i = #_arMotors, 1, -1 do
            local m = _arMotors[i]
            if not m or not m.Parent then
                table.remove(_arMotors, i)
            elseif not m.Enabled then
                m.Enabled = true
            end
        end
        if hum and hum.Parent then
            local st = hum:GetState()
            if st == Enum.HumanoidStateType.FallingDown or st == Enum.HumanoidStateType.Physics then
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
            end
        end
    end)
end

local function arStart()
    _arRefCount = _arRefCount + 1
    if _arRefCount > 1 then return end
    _arApply(LP.Character)
    if _arCharConn then _arCharConn:Disconnect() end
    _arCharConn = LP.CharacterAdded:Connect(function(char)
        if _arRefCount > 0 then task.wait(0.15) _arApply(char) end
    end)
end

local function arStop()
    _arRefCount = mmax(0, _arRefCount - 1)
    if _arRefCount > 0 then return end
    if _arSteppedConn then _arSteppedConn:Disconnect(); _arSteppedConn = nil end
    if _arDescConn    then _arDescConn:Disconnect();    _arDescConn    = nil end
    if _arCharConn    then _arCharConn:Disconnect();    _arCharConn    = nil end
    _arMotors = {}
end

-- ═══════════════════════════════════════════════
-- HITBOX EXPANDER (PreSimulation)
-- ═══════════════════════════════════════════════
local _hbShadows    = {}
local _hbOrigSz     = {}
local _hbConns      = {}
local _hbPlayerConn = nil
local _hbTickConn   = nil
local _hbLastSize   = -1

local HB_PARTS = {
    { n = "HumanoidRootPart", m = 1.0 },
    { n = "UpperTorso",       m = 1.0 },
    { n = "LowerTorso",       m = 1.0 },
    { n = "Torso",            m = 1.0 },
    { n = "Head",             m = 1.5 },
}

local function _hbApply(char)
    if not char or not char.Parent then return end
    if _hbOrigSz[char] then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local base = mmin(mmax(CFG.HitboxSize, 1), 30)
    local saved = {}
    for _, def in ipairs(HB_PARTS) do
        local p = char:FindFirstChild(def.n)
        if p and p:IsA("BasePart") then
            saved[def.n] = { sz = p.Size, cc = p.CanCollide }
            local ns = base * def.m
            pcall(function()
                p.Size       = V3new(ns, ns, ns)
                p.CanCollide = false
            end)
        end
    end
    _hbOrigSz[char]  = saved
    local head = char:FindFirstChild("Head")
    _hbShadows[char] = head or hrp
end

local function _hbRestore(char)
    local saved = _hbOrigSz[char]
    if not saved then return end
    for name, orig in pairs(saved) do
        local p = char and char:FindFirstChild(name)
        if p and p:IsA("BasePart") then
            pcall(function()
                p.Size       = orig.sz
                p.CanCollide = orig.cc
            end)
        end
    end
    _hbOrigSz[char]  = nil
    _hbShadows[char] = nil
end

local function _hbApplyAll()
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP and pl.Character then _hbApply(pl.Character) end
    end
end

local function _hbRestoreAll()
    for char in pairs(_hbOrigSz) do _hbRestore(char) end
    _hbShadows = {}
    _hbOrigSz  = {}
end

local function _hbTick()
    if not CFG.HitboxOn then return end
    local base = mmin(mmax(CFG.HitboxSize, 1), 30)
    local sizeChanged = (base ~= _hbLastSize)
    if sizeChanged then _hbLastSize = base end
    for char, saved in pairs(_hbOrigSz) do
        if char and char.Parent then
            for _, def in ipairs(HB_PARTS) do
                if saved[def.n] then
                    local p = char:FindFirstChild(def.n)
                    if p and p:IsA("BasePart") then
                        if sizeChanged then
                            local ns = base * def.m
                            pcall(function() p.Size = V3new(ns, ns, ns) end)
                        end
                        if p.CanCollide then
                            pcall(function() p.CanCollide = false end)
                        end
                    end
                end
            end
        else
            _hbOrigSz[char]  = nil
            _hbShadows[char] = nil
        end
    end
end

local function hitboxStart()
    CFG.HitboxOn = true
    _hbLastSize = -1
    _hbApplyAll()
    if not _hbTickConn then _hbTickConn = Run.Heartbeat:Connect(_hbTick) end
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP and not _hbConns[pl] then
            _hbConns[pl] = pl.CharacterAdded:Connect(function(char)
                char:WaitForChild("HumanoidRootPart", 6)
                if CFG.HitboxOn then task.wait(0.1) _hbApply(char) end
            end)
        end
    end
    if not _hbPlayerConn then
        _hbPlayerConn = Players.PlayerAdded:Connect(function(pl)
            if pl == LP then return end
            _hbConns[pl] = pl.CharacterAdded:Connect(function(char)
                char:WaitForChild("HumanoidRootPart", 6)
                if CFG.HitboxOn then task.wait(0.1) _hbApply(char) end
            end)
        end)
    end
end

local function hitboxStop()
    CFG.HitboxOn = false
    if _hbTickConn then pcall(function() _hbTickConn:Disconnect() end); _hbTickConn = nil end
    _hbRestoreAll()
    for pl, conn in pairs(_hbConns) do pcall(function() conn:Disconnect() end) end
    _hbConns = {}
    if _hbPlayerConn then pcall(function() _hbPlayerConn:Disconnect() end); _hbPlayerConn = nil end
end

