-- Chams
local function updateChams(pl, char)
    if not CFG.ChamsOn then
        if _chamsAdornments[pl] then
            for _, b in ipairs(_chamsAdornments[pl]) do pcall(function() b:Destroy() end) end
            _chamsAdornments[pl] = nil
        end
        return
    end
    if char and char.Parent then
        local adorns = _chamsAdornments[pl]
        if not adorns then
            adorns = {}
            for _, p in ipairs(char:GetChildren()) do
                if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                    local b = Instance.new("BoxHandleAdornment")
                    b.Size = p.Size; b.Color3 = CFG.ChamsColor; b.Transparency = 0.45
                    b.AlwaysOnTop = true; b.ZIndex = 5; b.Adornee = p; b.Parent = p
                    adorns[#adorns + 1] = b
                end
            end
            _chamsAdornments[pl] = adorns
        else
            for _, b in ipairs(adorns) do
                if b and b.Parent then b.Color3 = CFG.ChamsColor end
            end
        end
    end
end

