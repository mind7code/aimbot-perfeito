local function _hidePlayer(d)
    if not d then return end
    if d.visual and d.visual.gui then d.visual.gui.Enabled = false end
    if d.nameLbl then d.nameLbl.Visible = false end
    if d.distLbl then d.distLbl.Visible = false end
    if d.skelLines then for _, l in ipairs(d.skelLines) do if l then l.Visible = false end end end
    if d.skelHead then d.skelHead.Visible = false end
    if d.boxSq then d.boxSq.Visible = false end
    if d.hpBg then d.hpBg.Visible = false end
    if d.hpFg then d.hpFg.Visible = false end
    if d.tracerLine then d.tracerLine.Visible = false end
end

local function espAdd(player)
    if not player or player == LP then return end
    if _espData[player] then return end

    local visual = createESPVisual(player)

    local nameLbl = safeDrawingNew("Text")
    if nameLbl then nameLbl.Size = 13; nameLbl.Center = true; nameLbl.Outline = true; nameLbl.OutlineColor = C3rgb(0, 0, 0) end

    local distLbl = safeDrawingNew("Text")
    if distLbl then distLbl.Size = 11; distLbl.Center = true; distLbl.Outline = true; distLbl.OutlineColor = C3rgb(0, 0, 0) end

    local skelLines = {}
    for i = 1, 12 do
        local l = safeDrawingNew("Line")
        if l then l.Thickness = 1.5; l.Visible = false; skelLines[i] = l end
    end

    local skelHead = safeDrawingNew("Circle")
    if skelHead then skelHead.Thickness = 1.5; skelHead.Filled = false; skelHead.NumSides = 16; skelHead.Visible = false end

    local boxSq = safeDrawingNew("Square")
    if boxSq then boxSq.Thickness = 1.5; boxSq.Filled = false; boxSq.Visible = false end

    local hpBg = safeDrawingNew("Square")
    if hpBg then hpBg.Thickness = 1; hpBg.Filled = true; hpBg.Color = C3rgb(20, 20, 20); hpBg.Visible = false end

    local hpFg = safeDrawingNew("Square")
    if hpFg then hpFg.Thickness = 1; hpFg.Filled = true; hpFg.Visible = false end

    local tracerLine = safeDrawingNew("Line")
    if tracerLine then tracerLine.Thickness = 1.2; tracerLine.Visible = false end

    _espData[player] = {
        visual = visual,
        nameLbl = nameLbl,
        distLbl = distLbl,
        skelLines = skelLines,
        skelHead = skelHead,
        boxSq = boxSq,
        hpBg = hpBg,
        hpFg = hpFg,
        tracerLine = tracerLine,
    }
end

local function espRemove(player)
    local d = _espData[player]
    if not d then return end
    if d.visual and d.visual.gui then pcall(function() d.visual.gui:Destroy() end) end
    if d.nameLbl then pcall(function() d.nameLbl:Remove() end) end
    if d.distLbl then pcall(function() d.distLbl:Remove() end) end
    if d.skelLines then for _, l in ipairs(d.skelLines) do if l then pcall(function() l:Remove() end) end end end
    if d.skelHead then pcall(function() d.skelHead:Remove() end) end
    if d.boxSq then pcall(function() d.boxSq:Remove() end) end
    if d.hpBg then pcall(function() d.hpBg:Remove() end) end
    if d.hpFg then pcall(function() d.hpFg:Remove() end) end
    if d.tracerLine then pcall(function() d.tracerLine:Remove() end) end
    _espData[player] = nil
end

local function espClear()
    for pl in pairs(_espData) do
        espRemove(pl)
    end
    _espData = {}
end

local function espStart()
    CFG.ESPOn = true
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP then espAdd(pl) end
    end
end

local function espStop()
    CFG.ESPOn = false
    for pl, d in pairs(_espData) do
        _hidePlayer(d)
    end
end

local function espRefreshColors()
    for _, d in pairs(_espData) do
        if d.nameLbl then d.nameLbl.Color = CFG.ESPPlayerColor end
        if d.boxSq then d.boxSq.Color = CFG.ESPBoxColor end
        if d.tracerLine then d.tracerLine.Color = CFG.TracerColor end
        if d.visual and d.visual.frame then d.visual.frame.BackgroundColor3 = CFG.ESPPlayerColor end
    end
end

