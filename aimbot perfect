local rcParams = RaycastParams.new()
rcParams.FilterType = Enum.RaycastFilterType.Exclude
pcall(function() rcParams.RespectCanCollide = true end)

local function _nearestPointOnPart(part)
    if not part or not part.Parent then return part and part.Position or V3zero end
    local camPos2 = Cam.CFrame.Position
    local camDir  = Cam.CFrame.LookVector
    local lPos    = part.CFrame:PointToObjectSpace(camPos2)
    local lDir    = part.CFrame:VectorToObjectSpace(camDir)
    local denom   = lDir:Dot(lDir)
    local tVal    = denom > 1e-10 and mmax(0, -lPos:Dot(lDir) / denom) or 0
    local closest = lPos + lDir * tVal
    local h       = part.Size * 0.5
    local clamped = V3new(
        mclamp(closest.X, -h.X, h.X),
        mclamp(closest.Y, -h.Y, h.Y),
        mclamp(closest.Z, -h.Z, h.Z)
    )
    return part.CFrame:PointToWorldSpace(clamped)
end

local _rcFilter = {}
local function isVisible(part, ownerChar)
    if not CFG.WallCheck then return true end
    local myChar2  = LP.Character
    local ancestor = ownerChar or (part and part:FindFirstAncestorWhichIsA("Model")) or part.Parent

    _rcFilter[1] = myChar2
    _rcFilter[2] = ancestor
    _rcFilter[3] = Cam
    rcParams.FilterDescendantsInstances = _rcFilter

    local targetPos = _nearestPointOnPart(part)
    local res = workspace:Raycast(Cam.CFrame.Position, targetPos - Cam.CFrame.Position, rcParams)
    return res == nil
end

local _aimBest, _aimBestD, _aimCX, _aimCY = nil, 0, 0, 0
local _aimLPChar = nil
local _aimMyPos  = nil

local function _checkModel(model, playerObj)
    if not model or model == _aimLPChar then return end
    local head = model:FindFirstChild("Head") or model:FindFirstChild("HumanoidRootPart")
    local hum  = model:FindFirstChildWhichIsA("Humanoid")
    if not head or not hum then return end
    if hum.Health <= 0 or hum.Health ~= hum.Health then return end

    if CFG.AimbotMaxDist > 0 and _aimMyPos then
        local adist = (head.Position - _aimMyPos).Magnitude
        if adist > CFG.AimbotMaxDist then return end
    end

    if playerObj and CFG.TeamCheck then
        local pTeam = playerObj.Team
        local lTeam = LP.Team
        if pTeam ~= nil and lTeam ~= nil and pTeam == lTeam then
            return
        end
    end

    local seat       = hum.SeatPart
    local shadowPart = CFG.HitboxOn and _hbShadows[model]
    local effectPos  = (seat and seat.Parent and seat.Position)
                    or (shadowPart and shadowPart.Parent and shadowPart.Position)
                    or head.Position
    local aimPart  = (shadowPart and shadowPart.Parent and shadowPart) or head
    local pos, vis = Cam:WorldToViewportPoint(effectPos)
    if not vis or pos.Z < 0 then return end

    local dx, dy = pos.X - _aimCX, pos.Y - _aimCY
    local sd = msqrt(dx*dx + dy*dy)
    if sd < _aimBestD and isVisible(aimPart, model) then
        _aimBest  = aimPart
        _aimBestD = sd
    end
end

local function getAimTarget()
    _aimBest   = nil
    _aimBestD  = CFG.FOV
    _aimCX     = Cam.ViewportSize.X * 0.5
    _aimCY     = Cam.ViewportSize.Y * 0.5
    _aimLPChar = LP.Character
    local myH  = _aimLPChar and _aimLPChar:FindFirstChild("HumanoidRootPart")
    _aimMyPos  = myH and myH.Position or nil

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then _checkModel(p.Character, p) end
    end
    return _aimBest
end

