-- ═══════════════════════════════════════════════
-- FLY ANTI-DETECT (AssemblyLinearVelocity)
-- ═══════════════════════════════════════════════
local _flyConn, _flyCharConn = nil, nil
local _flyPrevWalk, _flyPrevJump = 16, 50

local function flyStart()
    if _flyConn then return end
    local char = LP.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    local hum  = char and char:FindFirstChildWhichIsA("Humanoid")
    if not hrp or not hum then return end

    _flyPrevWalk = hum.WalkSpeed
    _flyPrevJump = hum.JumpPower
    hum.WalkSpeed = 0
    hum.JumpPower = 0
    CFG.FlyOn = true
    arStart()

    local grav = workspace.Gravity
    _flyConn = Run.RenderStepped:Connect(function(dt)
        local c = LP.Character
        local r = c and c:FindFirstChild("HumanoidRootPart")
        if not r then return end

        local speed = CFG.FlySpeed
        if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then speed = speed * 2.5 end

        local cf    = Cam.CFrame
        local fwd   = V3new(cf.LookVector.X, 0, cf.LookVector.Z)
        local right = V3new(cf.RightVector.X, 0, cf.RightVector.Z)
        fwd   = fwd.Magnitude   > 0.01 and fwd.Unit   or V3zero
        right = right.Magnitude > 0.01 and right.Unit or V3zero

        local dir = V3zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir = dir + fwd end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir = dir - fwd end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir = dir - right end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir = dir + right end
        if UIS:IsKeyDown(Enum.KeyCode.Space)       then dir = dir + V3new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir = dir - V3new(0, 1, 0) end

        local curV = r.AssemblyLinearVelocity
        pcall(function() r.MaxLinearVelocity = mhuge end)

        if dir.Magnitude > 0.01 then
            r.AssemblyLinearVelocity = dir.Unit * speed
        else
            r.AssemblyLinearVelocity = V3new(curV.X * 0.82, curV.Y * 0.82 - (grav * dt), curV.Z * 0.82)
        end
    end)

    if _flyCharConn then _flyCharConn:Disconnect() end
    _flyCharConn = LP.CharacterAdded:Connect(function()
        if _flyConn then _flyConn:Disconnect(); _flyConn = nil end
        CFG.FlyOn = false
    end)
end

local function flyStop()
    CFG.FlyOn = false
    if _flyConn     then _flyConn:Disconnect();     _flyConn = nil end
    if _flyCharConn then _flyCharConn:Disconnect(); _flyCharConn = nil end

    local char = LP.Character
    local hum  = char and char:FindFirstChildWhichIsA("Humanoid")
    if hum then hum.WalkSpeed = _flyPrevWalk; hum.JumpPower = _flyPrevJump end

    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then hrp.AssemblyLinearVelocity = V3zero end
    arStop()
end

-- CAR BOOST
local carBoostConn = nil
local function _getOccupiedSeat()
    local char = LP.Character
    if not char then return nil end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    if not hum then return nil end
    local seat = hum.SeatPart
    if seat and seat:IsA("VehicleSeat") then return seat end
    return nil
end

local function carBoostStart()
    if carBoostConn then return end
    CFG.CarBoostOn = true
    carBoostConn = Run.Heartbeat:Connect(function()
        local seat = _getOccupiedSeat()
        if not seat then return end
        local vehModel = seat:FindFirstAncestorWhichIsA("Model")
        if not vehModel then return end
        local root = vehModel.PrimaryPart or seat
        if not root then return end
        local speed = CFG.CarSpeed
        local fwd = V3new(seat.CFrame.LookVector.X, 0, seat.CFrame.LookVector.Z)
        if fwd.Magnitude < 0.01 then return end
        fwd = fwd.Unit
        local curY = root.AssemblyLinearVelocity.Y
        pcall(function() root.AssemblyLinearVelocity = V3new(fwd.X * speed, curY, fwd.Z * speed) end)
    end)
end

local function carBoostStop()
    CFG.CarBoostOn = false
    if carBoostConn then carBoostConn:Disconnect(); carBoostConn = nil end
end

-- ═══════════════════════════════════════════════
-- ESP CORE — SINGLE-PASS PROJECTION & SKELETON
-- ═══════════════════════════════════════════════
local _espData = {}
local _proj2D  = {}

local PROJ_NAMES = {
    "Head", "UpperTorso", "LowerTorso", "HumanoidRootPart", "Torso",
    "LeftUpperArm", "LeftLowerArm", "LeftHand",
    "RightUpperArm", "RightLowerArm", "RightHand",
    "LeftUpperLeg", "LeftLowerLeg", "LeftFoot",
    "RightUpperLeg", "RightLowerLeg", "RightFoot",
    "Left Arm", "Right Arm", "Left Leg", "Right Leg",
}

local function _projectAll(pc)
    local anyVis = false
    for _, name in ipairs(PROJ_NAMES) do
        local part = pc[name]
        if part and part.Parent then
            local sp, vis = Cam:WorldToViewportPoint(part.Position)
            if vis and sp.Z > 0 then
                _proj2D[name] = V2new(sp.X, sp.Y)
                anyVis = true
            else
                _proj2D[name] = false
            end
        else
            _proj2D[name] = false
        end
    end
    return anyVis and _proj2D.Head
end

local function _p(name1, name2)
    local v = _proj2D[name1]
    if v then return v end
    if name2 then return _proj2D[name2] or nil end
    return nil
end

local function _skelBone(line, pA, pB, thick)
    if pA and pB then
        line.From = pA; line.To = pB; line.Visible = true
        if line.Thickness ~= thick then line.Thickness = thick end
    else
        line.Visible = false
    end
end

local function _drawSkeletonFast(lines, col, thick)
    local head    = _p("Head")
    local upTorso = _p("UpperTorso", "Torso")
    local loTorso = _p("LowerTorso", "HumanoidRootPart")
    local lUA     = _p("LeftUpperArm",  "Left Arm")
    local lLA     = _p("LeftLowerArm")
    local lHand   = _p("LeftHand")
    local rUA     = _p("RightUpperArm", "Right Arm")
    local rLA     = _p("RightLowerArm")
    local rHand   = _p("RightHand")
    local lUL     = _p("LeftUpperLeg",  "Left Leg")
    local lLL     = _p("LeftLowerLeg")
    local lFoot   = _p("LeftFoot")
    local rUL     = _p("RightUpperLeg", "Right Leg")
    local rLL     = _p("RightLowerLeg")
    local rFoot   = _p("RightFoot")

    for _, l in ipairs(lines) do
        if l.Color ~= col then l.Color = col end
    end

    _skelBone(lines[1],  head,    upTorso, thick)
    _skelBone(lines[2],  upTorso, loTorso, thick)
    _skelBone(lines[3],  upTorso, lUA,     thick)
    _skelBone(lines[4],  lUA,     lLA or lHand, thick)
    _skelBone(lines[5],  lLA,     lHand,   thick)
    _skelBone(lines[6],  upTorso, rUA,     thick)
