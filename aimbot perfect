    local dot = Instance.new("Frame", track)
    dot.Size = UD2new(0, 13, 0, 13); dot.Position = val and UD2new(1, -15, 0.5, -6) or UD2new(0, 2, 0.5, -6)
    dot.BackgroundColor3 = val and T.DotOn or T.DotOff; dot.BorderSizePixel = 0; mkCorner(dot, 7)

