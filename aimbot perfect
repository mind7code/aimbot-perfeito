Run.RenderStepped:Connect(function(dt)
    local espOn    = CFG.ESPOn
    local toolOn   = CFG.ESPToolOn
    local invOn    = CFG.ESPInvOn
    local boxOn    = CFG.ESPBoxOn
    local tracerOn = CFG.TracersOn
    local chamsOn  = CFG.ChamsOn

    if not (espOn or toolOn or invOn or boxOn or tracerOn or chamsOn) then
        for _, d in pairs(_espData) do _hidePlayer(d) end
        return
    end

    local maxDist = CFG.ESPMaxDist
    local pCol    = CFG.ESPPlayerColor
    local tCol    = CFG.ESPToolColor
    local skThick = CFG.ESPSkelThick

    local myHrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    local myPos = myHrp and myHrp.Position
    local screenCenter = V2new(Cam.ViewportSize.X * 0.5, Cam.ViewportSize.Y)

    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP and not _espData[pl] then
            espAdd(pl)
        end
    end

    for pl, d in pairs(_espData) do
        local char = pl.Character
        if not char or not char.Parent then
            _hidePlayer(d)
            if _chamsAdornments[pl] then
                for _, b in ipairs(_chamsAdornments[pl]) do pcall(function() b:Destroy() end) end
                _chamsAdornments[pl] = nil
            end
            continue
        end

        if chamsOn then updateChams(pl, char) end

        local pc = _getPartCache(char)
        if not pc then _hidePlayer(d); continue end

        local head = pc.Head or char:FindFirstChild("Head")
        if not head or not head.Parent then _hidePlayer(d); continue end

        local headPos = head.Position
        local dist    = myPos and (headPos - myPos).Magnitude or 0

        if myPos and maxDist > 0 and dist > maxDist then
            _hidePlayer(d); continue
        end

        -- Atualização do ESP SurfaceGui
        if d.visual then
            if d.visual.gui then d.visual.gui.Enabled = espOn end
            if d.visual.frame then d.visual.frame.BackgroundColor3 = pCol end
            if d.visual.label then
                d.visual.label.Text = pl.Name .. " [" .. mfloor(dist) .. "m]"
                d.visual.label.TextColor3 = pCol
            end
        end

        local sp, vis = Cam:WorldToViewportPoint(headPos + V3new(0, 0.5, 0))
        if not vis or sp.Z <= 0 then
            if d.nameLbl then d.nameLbl.Visible = false end
            if d.distLbl then d.distLbl.Visible = false end
            if d.skelLines then for _, l in ipairs(d.skelLines) do if l then l.Visible = false end end end
            if d.skelHead then d.skelHead.Visible = false end
            if d.boxSq then d.boxSq.Visible = false end
            if d.hpBg then d.hpBg.Visible = false end
            if d.hpFg then d.hpFg.Visible = false end
            if d.tracerLine then d.tracerLine.Visible = false end
            continue
        end

        local sx, sy = sp.X, sp.Y

        if espOn and d.nameLbl then
            d.nameLbl.Visible = true
            d.nameLbl.Text = pl.Name
            d.nameLbl.Color = pCol
            d.nameLbl.Position = V2new(sx, sy - 18)

            if d.distLbl then
                d.distLbl.Visible = true
                d.distLbl.Text = mfloor(dist) .. "m"
                d.distLbl.Position = V2new(sx, sy - 4)
            end
        else
            if d.nameLbl then d.nameLbl.Visible = false end
            if d.distLbl then d.distLbl.Visible = false end
        end

        if tracerOn and d.tracerLine then
            d.tracerLine.From = screenCenter
            d.tracerLine.To = V2new(sx, sy)
            d.tracerLine.Color = CFG.TracerColor
            d.tracerLine.Visible = true
        elseif d.tracerLine then
            d.tracerLine.Visible = false
        end

        local headVis = _projectAll(pc)
        if headVis then
            if espOn then
                _drawSkeletonFast(d.skelLines, pCol, skThick)
                _drawSkelHeadFast(pc, d.skelHead, pCol, 2.0)
            else
                for _, l in ipairs(d.skelLines or {}) do if l then l.Visible = false end end
                if d.skelHead then d.skelHead.Visible = false end
            end

            local bx, by, bw, bh = _bboxFromProjections()
            if bx then
                if boxOn and d.boxSq then
                    d.boxSq.Position = V2new(bx, by)
                    d.boxSq.Size = V2new(bw, bh)
                    d.boxSq.Color = CFG.ESPBoxColor
                    d.boxSq.Visible = true
                elseif d.boxSq then
                    d.boxSq.Visible = false
                end

                if espOn then
                    local hum = pc._hum or char:FindFirstChildOfClass("Humanoid")
                    local pct = hum and hum.MaxHealth > 0 and mclamp(hum.Health / hum.MaxHealth, 0, 1) or 1
                    local barX = bx - 6; local barW = 3
                    local barH = bh; local fillH = barH * pct
                    if d.hpBg then d.hpBg.Visible = true; d.hpBg.Position = V2new(barX, by); d.hpBg.Size = V2new(barW, barH) end
                    if d.hpFg then d.hpFg.Visible = true; d.hpFg.Color = _hpColor(pct); d.hpFg.Position = V2new(barX, by + barH - fillH); d.hpFg.Size = V2new(barW, fillH) end
                else
                    if d.hpBg then d.hpBg.Visible = false end
                    if d.hpFg then d.hpFg.Visible = false end
                end
            else
                if d.boxSq then d.boxSq.Visible = false end
                if d.hpBg then d.hpBg.Visible = false end
                if d.hpFg then d.hpFg.Visible = false end
            end
        else
            for _, l in ipairs(d.skelLines or {}) do if l then l.Visible = false end end
            if d.skelHead then d.skelHead.Visible = false end
            if d.boxSq then d.boxSq.Visible = false end
            if d.hpBg then d.hpBg.Visible = false end
            if d.hpFg then d.hpFg.Visible = false end
        end
    end
end)

