local function _drawSkelHeadFast(pc, circle, col, thick)
    local headV2 = _proj2D.Head
    if not headV2 then circle.Visible = false; return end
    local headPart = pc.Head
    if not headPart or not headPart.Parent then circle.Visible = false; return end

    local edgeSp = Cam:WorldToViewportPoint(headPart.Position + V3new(headPart.Size.X * 0.55, 0, 0))
    local radius = mmax(4, mabs(edgeSp.X - headV2.X))

    circle.Position  = headV2
    circle.Radius    = radius
    circle.Thickness = thick
    if circle.Color ~= col then circle.Color = col end
    circle.Visible   = true
end

local function _bboxFromProjections()
    local hrpV2  = _proj2D.HumanoidRootPart
    local headV2 = _proj2D.Head
    if not hrpV2 or not headV2 then return nil end

    local minX, minY = mhuge, mhuge
    local maxX, maxY = -mhuge, -mhuge
    for _, name in ipairs(PROJ_NAMES) do
        local v = _proj2D[name]
        if v then
            local vx, vy = v.X, v.Y
            if vx < minX then minX = vx end
            if vy < minY then minY = vy end
            if vx > maxX then maxX = vx end
            if vy > maxY then maxY = vy end
        end
    end
    minX = minX - 3; minY = minY - 5
    maxX = maxX + 3; maxY = maxY + 5
    local w = maxX - minX; local h = maxY - minY
    if w < 4 or h < 8 then return nil end
    return minX, minY, w, h
end

