local _sliderDrags = {}
Run.RenderStepped:Connect(function()
    for _, sd in ipairs(_sliderDrags) do
        if not sd.active then continue end
        local trackAbs = sd.track.AbsolutePosition
        local trackSz  = sd.track.AbsoluteSize
        if trackSz.X <= 0 then continue end
        local p = mclamp((UIS:GetMouseLocation().X - trackAbs.X) / trackSz.X, 0, 1)
        local v = mfloor(sd.mn + p * (sd.mx - sd.mn))
        CFG[sd.key] = v; sd.valLbl.Text = tostring(v)
        sd.fill.Size = UD2new(p, 0, 1, 0); sd.knob.Position = UD2new(p, 0, 0.5, 0)
        if sd.onChange then sd.onChange(v) end
    end
end)

