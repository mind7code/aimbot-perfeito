        if hum and hum.Parent then
            local st = hum:GetState()
            if st == Enum.HumanoidStateType.FallingDown or st == Enum.HumanoidStateType.Physics or st == Enum.HumanoidStateType.Ragdoll then
                pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
            end
        end
    end)
end

local function arStart()
    _arRefCount = _arRefCount + 1
    if _arRefCount > 1 then return end
    _arApply(LP.Character)
    if _arCharConn then _arCharConn:Disconnect() end
    _arCharConn = LP.CharacterAdded:Connect(function(char)
        if _arRefCount > 0 then task.wait(0.15) _arApply(char) end
    end)
end

local function arStop()
    _arRefCount = mmax(0, _arRefCount - 1)
    if _arRefCount > 0 then return end
    if _arSteppedConn then _arSteppedConn:Disconnect(); _arSteppedConn = nil end
    if _arCharConn    then _arCharConn:Disconnect();    _arCharConn    = nil end
end

-- ═══════════════════════════════════════════════
-- HITBOX EXPANDER (Universal Character Scaling & Multi-Rig Support)
-- ═══════════════════════════════════════════════
local _hbShadows    = {}
local _hbOrigSz     = {}
local _hbConns      = {}
local _hbPlayerConn = nil

local function _findHead(char)
    if not char then return nil end
    local head = char:FindFirstChild("Head") or char:FindFirstChild("head")
    if head and head:IsA("BasePart") then return head end
    for _, p in ipairs(char:GetChildren()) do
        if p:IsA("BasePart") and (p.Name:lower():find("head") or p.Name:lower():find("cabeca")) then
            return p
        end
    end
    return nil
end

local function _findTorsoParts(char)
    local parts = {}
    if not char then return parts end
    local candidates = {"UpperTorso", "Torso", "LowerTorso", "Chest"}
    for _, name in ipairs(candidates) do
        local p = char:FindFirstChild(name)
        if p and p:IsA("BasePart") then
            table.insert(parts, p)
        end
    end
    return parts
end

local function _hbApply(char)
    if not char or not char.Parent then return end
    local head = _findHead(char)
    local torsoParts = _findTorsoParts(char)
    if not head and #torsoParts == 0 then return end

    local base = mmin(mmax(CFG.HitboxSize, 1), 60)
    local targetChoice = CFG.HitboxPart or "Head"

    if not _hbOrigSz[char] then
        _hbOrigSz[char] = {}
    end
    local saved = _hbOrigSz[char]

    local targetParts = {}
    if targetChoice == "Head" then
        if head then table.insert(targetParts, head) else targetParts = torsoParts end
    elseif targetChoice == "Torso" or targetChoice == "RootPart" then
        targetParts = torsoParts
    else -- "All"
        if head then table.insert(targetParts, head) end
        for _, tp in ipairs(torsoParts) do
            table.insert(targetParts, tp)
        end
    end

    for _, p in ipairs(targetParts) do
        if p and p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            local name = p.Name
            if not saved[name] then
                saved[name] = {
                    part         = p,
                    sz           = p.Size,
                    cc           = p.CanCollide,
                    ml           = p.Massless,
                    tp           = p.Transparency
                }
            end

            pcall(function()
                p.Massless     = true
                p.CanCollide   = false
                p.CanTouch     = true
                p.Size         = V3new(base, base, base)
                p.Transparency = 0.5
            end)
        end
    end
    _hbOrigSz[char] = saved
    _hbShadows[char] = head or targetParts[1]
end

local function _hbRestore(char)
    if not char then return end
    local saved = _hbOrigSz[char]
    if saved then
        for _, orig in pairs(saved) do
            local p = orig.part or (char:FindFirstChild(orig.name or ""))
            if p and p:IsA("BasePart") then
                pcall(function()
                    p.Size         = orig.sz
                    p.CanCollide   = orig.cc
                    p.Massless     = orig.ml
                    p.Transparency = orig.tp
                end)
            end
        end
    else
        local head = _findHead(char)
        if head and head:IsA("BasePart") then
            pcall(function()
                head.Size         = V3new(1.2, 1.2, 1.2)
                head.CanCollide   = true
                head.Massless     = false
                head.Transparency = 0
            end)
        end
    end
    _hbOrigSz[char]  = nil
    _hbShadows[char] = nil
end

local function _hbApplyAll()
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP and pl.Character then
            _hbApply(pl.Character)
        end
    end
end

local function _hbRestoreAll()
    local charList = {}
    for char in pairs(_hbOrigSz) do
        table.insert(charList, char)
    end
    for _, char in ipairs(charList) do
        _hbRestore(char)
    end
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP and pl.Character then
            _hbRestore(pl.Character)
        end
    end
    _hbShadows = {}
    _hbOrigSz  = {}
end

local function hitboxStart()
    CFG.HitboxOn = true
    _hbApplyAll()

    if not _hbPlayerConn then
        _hbPlayerConn = Players.PlayerAdded:Connect(function(pl)
            if pl == LP then return end
            _hbConns[pl] = pl.CharacterAdded:Connect(function(char)
                char:WaitForChild("Head", 6)
                if CFG.HitboxOn then
                    _hbApply(char)
                end
            end)
        end)
    end
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP and not _hbConns[pl] then
            _hbConns[pl] = pl.CharacterAdded:Connect(function(char)
                char:WaitForChild("HumanoidRootPart", 6)
                if CFG.HitboxOn then
                    task.wait(0.2)
                    _hbApply(char)
                end
            end)
        end
    end
end

local function hitboxStop()
    CFG.HitboxOn = false
    if _hbTickConn then
        pcall(function() _hbTickConn:Disconnect() end)
        _hbTickConn = nil
    end
    _hbRestoreAll()
    for pl, conn in pairs(_hbConns) do pcall(function() conn:Disconnect() end) end
    _hbConns = {}
    if _hbPlayerConn then pcall(function() _hbPlayerConn:Disconnect() end); _hbPlayerConn = nil end
end

