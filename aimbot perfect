local function _projectAll(pc)
    local anyVis = false
    for _, name in ipairs(CACHE_PART_NAMES) do
        local part = pc[name]
        if part and part.Parent then
            local sp, vis = Cam:WorldToViewportPoint(part.Position)
            if vis and sp.Z > 0 then
                _proj2D[name] = Vector2.new(sp.X, sp.Y)
                anyVis = true
            else
                _proj2D[name] = false
            end
        else
            _proj2D[name] = false
        end
    end
    return anyVis and _proj2D["Head"]
end

local function _p(name1, name2)
    local v = _proj2D[name1]
    if v then return v end
    if name2 then return _proj2D[name2] or nil end
    return nil
end

local function _drawSkeletonFast(lines, col, thick)
    local idx = 1
    local function l(p1, p2)
        local ln = lines[idx]; idx = idx + 1
        if not ln then return end
        if p1 and p2 then
            ln.From, ln.To, ln.Color, ln.Thickness, ln.Visible = p1, p2, col, thick, true
        else
            ln.Visible = false
        end
    end
    local head = _p("Head")
    local ut = _p("UpperTorso", "Torso")
    local lt = _p("LowerTorso", "HumanoidRootPart")
    l(head, ut); l(ut, lt)
    l(ut, _p("LeftUpperArm")); l(_p("LeftUpperArm"), _p("LeftLowerArm") or _p("LeftHand"))
    l(_p("LeftLowerArm") and _p("LeftHand") or nil, _p("LeftLowerArm") and _p("LeftHand") or nil)
    l(ut, _p("RightUpperArm")); l(_p("RightUpperArm"), _p("RightLowerArm") or _p("RightHand"))
    l(_p("RightLowerArm") and _p("RightHand") or nil, _p("RightLowerArm") and _p("RightHand") or nil)
    l(lt, _p("LeftUpperLeg")); l(_p("LeftUpperLeg"), _p("LeftLowerLeg") or _p("LeftFoot"))
    l(_p("LeftLowerLeg") and _p("LeftFoot") or nil, _p("LeftLowerLeg") and _p("LeftFoot") or nil)
    l(lt, _p("RightUpperLeg")); l(_p("RightUpperLeg"), _p("RightLowerLeg") or _p("RightFoot"))
    l(_p("RightLowerLeg") and _p("RightFoot") or nil, _p("RightLowerLeg") and _p("RightFoot") or nil)
    for i = idx, #lines do if lines[i] then lines[i].Visible = false end end
end

local function _drawSkelHeadFast(pc, skelHead, col, thick)
    if not skelHead then return end
    local head = pc["Head"]
    if head and head.Parent then
        local sp, vis = Cam:WorldToViewportPoint(head.Position)
        if vis and sp.Z > 0 then
            skelHead.Position = Vector2.new(sp.X, sp.Y)
            skelHead.Radius = math.max(3, 1400 / sp.Z)
            skelHead.Color, skelHead.Thickness, skelHead.Visible = col, thick, true
            return
        end
    end
    skelHead.Visible = false
end

local function _bboxFromProjections()
    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local count = 0
    for _, pos in pairs(_proj2D) do
        if pos then
            if pos.X < minX then minX = pos.X end
            if pos.Y < minY then minY = pos.Y end
            if pos.X > maxX then maxX = pos.X end
            if pos.Y > maxY then maxY = pos.Y end
            count = count + 1
        end
    end
    if count >= 2 and minX < maxX and minY < maxY then
        local pad = 4
        return minX - pad, minY - pad, (maxX - minX) + (pad * 2), (maxY - minY) + (pad * 2)
    end
    return nil, nil, nil, nil
end

