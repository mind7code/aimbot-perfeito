    if not aimPos or aimPos == V3zero then return end

    local dest = CFnew(Cam.CFrame.Position, aimPos)
    if CFG.Smooth then
        local alpha = 1 - mpow(1 - mclamp(CFG.SmoothAmt / 100, 0.01, 0.99), dt * 60)
        pcall(function() Cam.CFrame = Cam.CFrame:Lerp(dest, alpha) end)
    else
        pcall(function() Cam.CFrame = dest end)
    end
end)

