-- SISTEMA DE COOLDOWN & INPUT GLOBAL
-- ═══════════════════════════════════════════════
local _cooldowns = {
    aimbot = 0,
    esp = 0,
    fly = 0,
    noclip = 0,
    hitbox = 0,
    carboost = 0
}

local function checkCooldown(feature)
    local now = tick()
    if now < (_cooldowns[feature] or 0) then
        return false
    end
    return true
end

local function setCooldown(feature, seconds)
    _cooldowns[feature] = tick() + seconds
end

UIS.InputBegan:Connect(function(inp, gpe)
    if inp.UserInputType ~= Enum.UserInputType.Keyboard then return end

    if inp.KeyCode == KEYS.Panel then
        Panel.Visible = not Panel.Visible; return
    end

    if gpe then return end

    if inp.KeyCode == KEYS.Aimbot then
        if not checkCooldown("aimbot") then return end
        setCooldown("aimbot", 0.5)

        CFG.Aimbot = not CFG.Aimbot
        if toggleRefs.Aimbot then toggleRefs.Aimbot(CFG.Aimbot) end
    elseif inp.KeyCode == KEYS.ESP then
        if not checkCooldown("esp") then return end
        setCooldown("esp", 0.5)

        CFG.ESPOn = not CFG.ESPOn
        if CFG.ESPOn then espStart() else espStop() end
        if toggleRefs.ESPOn then toggleRefs.ESPOn(CFG.ESPOn) end
    elseif inp.KeyCode == KEYS.Hitbox then
        if not checkCooldown("hitbox") then return end
        setCooldown("hitbox", 0.5)

        CFG.HitboxOn = not CFG.HitboxOn
        if CFG.HitboxOn then hitboxStart() else hitboxStop() end
        if toggleRefs.HitboxOn then toggleRefs.HitboxOn(CFG.HitboxOn) end
    elseif inp.KeyCode == KEYS.Fly then
        if not checkCooldown("fly") then return end
        setCooldown("fly", 0.5)

        CFG.FlyOn = not CFG.FlyOn
        if CFG.FlyOn then flyStart() else flyStop() end
        if toggleRefs.FlyOn then toggleRefs.FlyOn(CFG.FlyOn) end
    elseif inp.KeyCode == KEYS.Noclip then
        if not checkCooldown("noclip") then return end
        setCooldown("noclip", 0.5)

        if CFG.NoclipOn then noclipStop() else noclipStart() end
        if toggleRefs.NoclipOn then toggleRefs.NoclipOn(CFG.NoclipOn) end
    elseif inp.KeyCode == KEYS.CarBoost then
        if not checkCooldown("carboost") then return end
        setCooldown("carboost", 0.5)

        if CFG.CarBoostOn then carBoostStop() else carBoostStart() end
        if toggleRefs.CarBoostOn then toggleRefs.CarBoostOn(CFG.CarBoostOn) end
    end
end)

