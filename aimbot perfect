local function addKeybind(parent, order, lbTxt, keyId)
    local f = Instance.new("Frame", parent)
    f.Size = UD2new(1, -12, 0, 36); f.BackgroundColor3 = T.Row; f.BorderSizePixel = 0; f.LayoutOrder = order
    mkCorner(f, 7)
    local ll = mkLabel(f, lbTxt, 11, T.TextDim, Enum.Font.Gotham)
    ll.Size = UD2new(0.52, 0, 1, 0); ll.Position = UD2new(0, 12, 0, 0)

    local btn = Instance.new("TextButton", f)
    btn.Size = UD2new(0, 100, 0, 22); btn.Position = UD2new(1, -108, 0.5, -11)
    btn.BackgroundColor3 = T.Surface; btn.Text = "[ " .. KEYS[keyId].Name .. " ]"
    btn.Font = Enum.Font.GothamBold; btn.TextColor3 = T.AccentBr; btn.TextSize = 10
    btn.AutoButtonColor = false; btn.BorderSizePixel = 0; mkCorner(btn, 5)

    btn.MouseEnter:Connect(function() tw(btn, {BackgroundColor3 = T.RowHover}) end)
    btn.MouseLeave:Connect(function() tw(btn, {BackgroundColor3 = T.Surface}) end)

    local waiting = false
    btn.MouseButton1Click:Connect(function()
        if waiting then
            waiting = false; btn.Text = "[ " .. KEYS[keyId].Name .. " ]"
            tw(btn, {BackgroundColor3 = T.Surface, TextColor3 = T.AccentBr})
        else
            waiting = true; btn.Text = "▶ pressione..."
            tw(btn, {BackgroundColor3 = T.RowHover, TextColor3 = T.AccentBr})
        end
    end)

    UIS.InputBegan:Connect(function(inp, _gpe)
        if not waiting then return end
        if inp.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if inp.KeyCode ~= Enum.KeyCode.Escape then KEYS[keyId] = inp.KeyCode end
        waiting = false
        btn.Text = "[ " .. KEYS[keyId].Name .. " ]"
        tw(btn, {BackgroundColor3 = T.Surface, TextColor3 = T.AccentBr})
    end)
end

