local _espStep  = 0
local _invTimer = 0

Run.Heartbeat:Connect(function(rawDt)
    _espStep = _espStep + rawDt
    if _espStep < 0.0167 then return end
    local dt = _espStep; _espStep = 0

    local espOn   = CFG.ESPOn
    local toolOn  = CFG.ESPToolOn
    local invOn   = CFG.ESPInvOn
    local maxDist = CFG.ESPMaxDist
    local pCol    = CFG.ESPPlayerColor
    local tCol    = CFG.ESPToolColor
    local skThick = CFG.ESPSkelThick

    if not (espOn or toolOn or invOn) then return end

    local myChar = LP.Character
    local myHRPp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myPos  = myHRPp and myHRPp.Position

    local camPos  = Cam.CFrame.Position
    local camLook = Cam.CFrame.LookVector

    for pl, d in pairs(_espData) do
        local char = pl.Character
        if not char then _hidePlayer(d); continue end

        local pc = _getPartCache(char)
        if not pc then _hidePlayer(d); continue end

        local head = pc.Head
        if not head or not head.Parent then _hidePlayer(d); continue end

        local headPos = head.Position
        local dist    = myPos and (headPos - myPos).Magnitude or 0

        if myPos and maxDist > 0 and dist > maxDist then
            _hidePlayer(d); continue
        end

        local toPlayer = headPos - camPos
        if toPlayer.Magnitude > 2 and camLook:Dot(toPlayer.Unit) < -0.1 then
            _hidePlayer(d); continue
        end

        local sp, vis = Cam:WorldToViewportPoint(headPos + V3new(0, 2.4, 0))
        local onScreen = vis and sp.Z > 0
        local sx, sy   = sp.X, sp.Y

        if espOn and onScreen then
            local headVis = _projectAll(pc)

            d.nameLbl.Visible = true
            if d.nameLbl.Text  ~= pl.Name then d.nameLbl.Text  = pl.Name end
            if d.nameLbl.Color ~= pCol    then d.nameLbl.Color = pCol    end
            d.nameLbl.Position = V2new(sx, sy - 2)

            local distStr = mfloor(dist) .. "m"
            d.distLbl.Visible = true
            if d.distLbl.Text ~= distStr then d.distLbl.Text = distStr end
            d.distLbl.Position = V2new(sx, sy + 10)

            if headVis then
                _drawSkeletonFast(d.skelLines, pCol, skThick)
                _drawSkelHeadFast(pc, d.skelHead, pCol, 2.0)

                local bx, by, bw, bh = _bboxFromProjections()
                if bx then
                    local hum = pc._hum
                    local pct = hum and hum.MaxHealth > 0 and mclamp(hum.Health / hum.MaxHealth, 0, 1) or 1
                    local barX = bx - 6; local barW = 3
                    local barH = bh; local fillH = barH * pct
                    d.hpBg.Visible  = true
                    d.hpBg.Position = V2new(barX, by)
                    d.hpBg.Size     = V2new(barW, barH)
                    d.hpFg.Visible  = true
                    d.hpFg.Color    = _hpColor(pct)
                    d.hpFg.Position = V2new(barX, by + barH - fillH)
                    d.hpFg.Size     = V2new(barW, fillH)
                else
                    d.hpBg.Visible=false; d.hpFg.Visible=false
                end
            else
                for _, l in ipairs(d.skelLines) do l.Visible=false end
                d.skelHead.Visible=false
                d.hpBg.Visible=false; d.hpFg.Visible=false
            end
        else
            d.nameLbl.Visible=false; d.distLbl.Visible=false
            for _, l in ipairs(d.skelLines) do l.Visible=false end
            d.skelHead.Visible=false
            d.hpBg.Visible=false; d.hpFg.Visible=false
        end
    end
end)

