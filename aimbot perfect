-- AIMBOT CORE
-- ═══════════════════════════════════════════════
local rcParams = RaycastParams.new()
rcParams.FilterType = Enum.RaycastFilterType.Exclude
pcall(function() rcParams.RespectCanCollide = true end)

local function _nearestPointOnPart(part)
    if not part or not part.Parent then return part and part.Position or V3zero end
    local camPos2 = Cam.CFrame.Position
    local camDir  = Cam.CFrame.LookVector
    local lPos    = part.CFrame:PointToObjectSpace(camPos2)
    local lDir    = part.CFrame:VectorToObjectSpace(camDir)
    local denom   = lDir:Dot(lDir)
    local tVal    = denom > 1e-10 and mmax(0, -lPos:Dot(lDir) / denom) or 0
    local closest = lPos + lDir * tVal
    local h       = part.Size * 0.5
    local clamped = V3new(
        mclamp(closest.X, -h.X, h.X),
        mclamp(closest.Y, -h.Y, h.Y),
        mclamp(closest.Z, -h.Z, h.Z)
    )
    return part.CFrame:PointToWorldSpace(clamped)
end

local function isVisible(part, ownerChar)
    if not CFG.WallCheck then return true end
    local myChar2  = LP.Character
    local ancestor = ownerChar or (part and part:FindFirstAncestorWhichIsA("Model")) or part.Parent

    local filter = {}
    if myChar2 then filter[#filter+1] = myChar2 end
    if ancestor then filter[#filter+1] = ancestor end
    filter[#filter+1] = Cam
    rcParams.FilterDescendantsInstances = filter

    local targetPos = _nearestPointOnPart(part)
    local res = workspace:Raycast(Cam.CFrame.Position, targetPos - Cam.CFrame.Position, rcParams)
    return res == nil
end

local _aimBest, _aimBestD, _aimCX, _aimCY = nil, 0, 0, 0
local _aimLPChar = nil
local _aimMyPos  = nil

local function _checkModel(model, playerObj)
    if not model or model == _aimLPChar then return end
    local head = model:FindFirstChild("Head")
    local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso") or model:FindFirstChild("HumanoidRootPart")
    local hum  = model:FindFirstChildWhichIsA("Humanoid")
    if not hum or hum.Health <= 0 or hum.Health ~= hum.Health then return end

    local targetPart = nil
    if CFG.TargetBone == "Head" then
        targetPart = head or model:FindFirstChild("Head") or torso
    elseif CFG.TargetBone == "Torso" then
        targetPart = torso or head
    else -- Closest
        if head and torso then
            local hsp, hvis = Cam:WorldToViewportPoint(head.Position)
            local tsp, tvis = Cam:WorldToViewportPoint(torso.Position)
            if hvis and tvis then
                local hd = (V2new(hsp.X, hsp.Y) - V2new(_aimCX, _aimCY)).Magnitude
                local td = (V2new(tsp.X, tsp.Y) - V2new(_aimCX, _aimCY)).Magnitude
                targetPart = (hd < td) and head or torso
            else
                targetPart = head or torso
            end
        else
            targetPart = head or torso
        end
    end

    if not targetPart then return end

    if CFG.AimbotMaxDist > 0 and _aimMyPos then
        local adist = (targetPart.Position - _aimMyPos).Magnitude
        if adist > CFG.AimbotMaxDist then return end
    end

    if playerObj and CFG.TeamCheck then
        local pTeam = playerObj.Team
        local lTeam = LP.Team
        if pTeam ~= nil and lTeam ~= nil and pTeam == lTeam then
            return
        end
    end

    local shadowPart = CFG.HitboxOn and (head or _hbShadows[model])
    local aimPart  = (shadowPart and shadowPart.Parent and shadowPart) or targetPart
    local targetWorldPos = aimPart.Position

    -- Prediction
    if CFG.Prediction then
        local vel = aimPart.AssemblyLinearVelocity or V3zero
        targetWorldPos = targetWorldPos + (vel * CFG.PredAmt)
    end

    local pos, vis = Cam:WorldToViewportPoint(targetWorldPos)
    if not vis or pos.Z < 0 then return end

    local dx, dy = pos.X - _aimCX, pos.Y - _aimCY
    local sd = msqrt(dx*dx + dy*dy)
    if sd < _aimBestD and isVisible(aimPart, model) then
        _aimBest  = aimPart
        _aimBestD = sd
    end
end

local function getAimTarget()
    _aimBest   = nil
    _aimBestD  = CFG.FOV
    _aimCX     = Cam.ViewportSize.X * 0.5
    _aimCY     = Cam.ViewportSize.Y * 0.5
    _aimLPChar = LP.Character
    local myH  = _aimLPChar and _aimLPChar:FindFirstChild("HumanoidRootPart")
    _aimMyPos  = myH and myH.Position

    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP and pl.Character then
            _checkModel(pl.Character, pl)
        end
    end

    return _aimBest
end

local function _getCrosshairTarget()
    local camPos = Cam.CFrame.Position
    local camDir = Cam.CFrame.LookVector * 2000
    local myChar = LP.Character

    local filter = {}
    if myChar then filter[#filter+1] = myChar end
    filter[#filter+1] = Cam
    rcParams.FilterDescendantsInstances = filter

    local res = workspace:Raycast(camPos, camDir, rcParams)
    if res and res.Instance then
        local hitModel = res.Instance:FindFirstAncestorWhichIsA("Model")
        if hitModel then
            local pl = Players:GetPlayerFromCharacter(hitModel)
            if pl and pl ~= LP then
                local hum = hitModel:FindFirstChildWhichIsA("Humanoid")
                if hum and hum.Health > 0 then
                    if CFG.TeamCheck and pl.Team and LP.Team and pl.Team == LP.Team then
                        return nil
                    end
                    return hitModel
                end
            end
        end
    end
    return nil
end

local function _doClick()
    pcall(function()
        local char = LP.Character
        if not char then return end

        local humanoid = char:FindFirstChildOfClass("Humanoid")
        if not humanoid or humanoid.Health <= 0 then return end

        local reactionTime = math.random(150, 300) / 1000
        task.wait(reactionTime)

        local target = _getCrosshairTarget()
        if not target then return end

        if math.random(1, 10) == 1 then
            task.wait(math.random(50, 150) / 1000)
            return
        end

        local tool = char:FindFirstChildOfClass("Tool")
        if tool and type(tool.Activate) == "function" then
            tool:Activate()
            task.wait(math.random(20, 60) / 1000)

            if math.random(1, 4) == 1 then
                task.wait(math.random(30, 80) / 1000)
                tool:Activate()
            end
        else
            if type(mouse1click) == "function" then
                mouse1click()
            elseif type(mouse1press) == "function" and type(mouse1release) == "function" then
                mouse1press()
                task.wait(0.01)
                mouse1release()
            end
        end

        task.wait(math.random(100, 400) / 1000)
    end)
end

-- AIMBOT CORE (RenderStepped & High Precision Lock)
Run.RenderStepped:Connect(function(dt)
    if not CFG.Aimbot then return end

    local targetPart = getAimTarget()
    if not targetPart or not targetPart.Parent then return end

    local aimPos = targetPart.Position

    if CFG.Prediction then
        local vel = targetPart.AssemblyLinearVelocity or V3zero
        if vel.Magnitude > 0.05 then
            aimPos = aimPos + (vel * CFG.PredAmt)
        end
    end

    local camPos = Cam.CFrame.Position
    if (aimPos - camPos).Magnitude > 0.01 then
        local targetCF = CFnew(camPos, aimPos)

        if CFG.Smooth then
            local alpha = mclamp((101 - CFG.SmoothAmt) * dt * 0.4, 0.05, 1)
            Cam.CFrame = Cam.CFrame:Lerp(targetCF, alpha)
        else
            Cam.CFrame = targetCF
        end
    end
end)

-- FOV CIRCLE & TRIGGERBOT LOOP
local _trigTimer = 0
Run.RenderStepped:Connect(function(dt)
    if FovCircle then
        FovCircle.Visible = CFG.ShowFOV
        FovCircle.Radius = CFG.FOV
        FovCircle.Position = V2new(Cam.ViewportSize.X * 0.5, Cam.ViewportSize.Y * 0.5)
    end

    -- TRIGGERBOT (Raycast 3D no Retículo + Fallback Projeção 2D)
    if CFG.Triggerbot then
        local hitChar = _getCrosshairTarget()
        if not hitChar then
            local aimTarget = getAimTarget()
            if aimTarget then
                local sp, vis = Cam:WorldToViewportPoint(aimTarget.Position)
                if vis and sp.Z > 0 then
                    local cx, cy = Cam.ViewportSize.X * 0.5, Cam.ViewportSize.Y * 0.5
                    if (V2new(sp.X, sp.Y) - V2new(cx, cy)).Magnitude <= 30 then
                        hitChar = aimTarget.Parent
                    end
                end
            end
        end

        if hitChar then
            _trigTimer = _trigTimer + dt
            if _trigTimer >= 0.04 then
                _trigTimer = 0
                task.spawn(_doClick)
            end
        else
            _trigTimer = 0
        end
    end
end)

