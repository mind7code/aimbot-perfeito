-- Hitbox
local function _findHead(char)
    if not char then return nil end
    local head = char:FindFirstChild("Head")
    if head and head:IsA("BasePart") then return head end
    return nil
end

local function _findTorsoParts(char)
    local parts = {}
    if not char then return parts end
    for _, name in ipairs({"UpperTorso", "Torso", "LowerTorso"}) do
        local p = char:FindFirstChild(name)
        if p and p:IsA("BasePart") then table.insert(parts, p) end
    end
    return parts
end

local function _hbApply(char)
    if not char or not char.Parent then return end
    local head = _findHead(char)
    local torsoParts = _findTorsoParts(char)
    if not head and #torsoParts == 0 then return end
    local base = math.min(math.max(CFG.HitboxSize, 1), 60)
    local targetChoice = CFG.HitboxPart or "Head"
    if not _hbOrigSz[char] then _hbOrigSz[char] = {} end
    local saved = _hbOrigSz[char]
    local targetParts = {}
    if targetChoice == "Head" then
        if head then table.insert(targetParts, head) else targetParts = torsoParts end
    else
        if head then table.insert(targetParts, head) end
        for _, tp in ipairs(torsoParts) do table.insert(targetParts, tp) end
    end
    for _, p in ipairs(targetParts) do
        if p and p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
            local name = p.Name
            if not saved[name] then
                saved[name] = { part = p, sz = p.Size, cc = p.CanCollide, ml = p.Massless, tp = p.Transparency }
            end
            pcall(function()
                p.Massless = true; p.CanCollide = false; p.Size = Vector3.new(base, base, base); p.Transparency = 0.5
            end)
        end
    end
    _hbOrigSz[char] = saved
    _hbShadows[char] = head or targetParts[1]
end

local function _hbRestore(char)
    if not char then return end
    local saved = _hbOrigSz[char]
    if saved then
        for _, orig in pairs(saved) do
            local p = orig.part or (char:FindFirstChild(orig.name or ""))
            if p and p:IsA("BasePart") then
                pcall(function()
                    p.Size = orig.sz; p.CanCollide = orig.cc; p.Massless = orig.ml; p.Transparency = orig.tp
                end)
            end
        end
    end
    _hbOrigSz[char] = nil; _hbShadows[char] = nil
end

local function _hbApplyAll()
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP and pl.Character then _hbApply(pl.Character) end
    end
end

local function _hbRestoreAll()
    for char in pairs(_hbOrigSz) do _hbRestore(char) end
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LP and pl.Character then _hbRestore(pl.Character) end
    end
end

